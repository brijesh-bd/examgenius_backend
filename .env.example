PORT=3000

# Required in production; set it in dev too so logins survive server restarts.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# MongoDB (local MongoDB Server).
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=examgenius

# Google AI Studio key (https://aistudio.google.com/apikey). Empty = preview mode.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Tried in order when the main model is overloaded (comma separated).
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.5-flash,gemini-flash-lite-latest
AI_TIMEOUT_MS=40000
# true = if all models are busy, serve sample questions (shown as "Preview" in the app)
AI_FALLBACK_TO_SAMPLES=true
AI_MAX_QUESTIONS=30
AI_GENERATIONS_PER_HOUR=20
# AI Study Notes hourly limit per student (separate from question generation)
AI_NOTES_PER_HOUR=20
# AI Study Notes model order (primary first). Flash-Lite models are ignored for notes.
# Default: primary only. Add gemini-3.5-flash only after approval:
# GEMINI_NOTES_MODELS=gemini-3.8-flash,gemini-3.5-flash
# Show curated outlines that are still drafts (review / dev only; never in production).
# NOTES_SHOW_DRAFT_OUTLINES=false

# Countdown per question in practice tests.
SECONDS_PER_QUESTION=60
